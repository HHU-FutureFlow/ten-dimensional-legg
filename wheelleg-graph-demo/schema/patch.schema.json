{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Graph transaction v2",
  "type": "object",
  "required": [
    "requestId",
    "baseRevision",
    "actor",
    "summary",
    "operations"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150
    },
    "baseRevision": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "node.add",
              "node.update",
              "node.remove",
              "port.add",
              "port.update",
              "port.remove",
              "edge.add",
              "edge.update",
              "edge.remove",
              "group.add",
              "group.update",
              "group.remove",
              "view.node.update",
              "view.edge.update",
              "view.group.update",
              "project.update",
              "viewport.update",
              "scene.add",
              "scene.update",
              "scene.remove"
            ]
          },
          "id": {
            "type": "string"
          },
          "value": {
            "type": "object"
          },
          "changes": {
            "type": "object"
          },
          "cascade": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
