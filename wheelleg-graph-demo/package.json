{
  "name": "project-graph-demo",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "node scripts/ensure-dependencies.mjs",
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "graph": "node --env-file-if-exists=.env scripts/graph-cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/browser-check.mjs",
    "test:portable": "node scripts/portable-check.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "ajv": "^8.17.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
